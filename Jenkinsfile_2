pipeline {
    agent any

    environment {
        APP_PORT = '9090'
        JOB_NAME = env.JOB_NAME
    }

    stages {
        stage('Build') {
            steps {
                script {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Integration Test') {
            parallel {
                stage('Running Application') {
                    agent any
                    steps {
                        script {
                            try {
                                timeout(time: 60, unit: 'SECONDS') {
                                    dir('target') {
                                        sh 'java -jar contact.war'
                                    }
                                }
                            } catch (Exception e) {
                                echo 'Application run timed out, proceeding to next step.'
                            }
                        }
                    }
                }

                stage('Running Test') {
                    steps {
                        script {
                            sleep 30
                            sh 'mvn test -Dtest=RestIT'
                        }
                    }
                }
            }
        }
    }
}
